// cryptobar module for Waybar.
//
// Merge it into ~/.config/waybar/config.jsonc: copy the "custom/crypto" block
// and add "custom/crypto" to one of the modules-left / modules-center /
// modules-right arrays.
{
  "custom/crypto": {
    "exec": "cryptobar bar",
    "return-type": "json",
    // Waybar can tick faster than the API: the cache absorbs the difference,
    // the configuration's `refresh_interval` is what drives the network.
    "interval": 30,
    // Must match `waybar_signal` in the cryptobar configuration.
    "signal": 8,
    "tooltip": true,
    "on-click": "cryptobar popup",
    "on-click-right": "cryptobar chart --window",
    "on-click-middle": "cryptobar refresh",
    "on-scroll-up": "cryptobar next",
    "on-scroll-down": "cryptobar prev"
  }
}
